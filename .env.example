# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: Public URL where this application is hosted.
APP_URL=

# FRONTEND_ORIGIN: Allowed CORS origin for authenticated API calls.
FRONTEND_ORIGIN=

# ADMIN CREDENTIALS & BOOTSTRAP SECRETS
# Admin Username (default: Roynorules)
ADMIN_USERNAME=Roynorules
# Bcrypt hash of the admin password (generate with: npx tsx -e "import bcrypt from 'bcryptjs'; console.log(await bcrypt.hash('YOUR_PASSWORD', 12))")
ADMIN_PASSWORD_HASH=
# One-time secret required to enroll or replace the authorized Telegram numeric user ID
ADMIN_BOOTSTRAP_SECRET=

# TELEGRAM BOT & ENCRYPTION CONFIGURATION
# 32-byte hex key used to encrypt the Telegram Bot Token at rest with AES-256-GCM
TELEGRAM_BOT_ENCRYPTION_KEY=
# Optional environment-configured Telegram Bot Token (or configure via the encrypted Admin Dashboard UI)
TELEGRAM_BOT_TOKEN=
# Secret token verified on incoming Telegram webhook requests
TELEGRAM_WEBHOOK_SECRET=

# POSTGRESQL DATABASE CONNECTION (Object Method variables)
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=
